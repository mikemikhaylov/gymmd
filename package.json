{
	"name": "gymmd",
	"version": "0.1.0",
	"description": "Obsidian plugin for tracking gym workouts with markdown-native storage",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
