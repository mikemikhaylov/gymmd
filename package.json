		"@types/react-dom": "^19.0.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.0",
		"obsidian": "latest",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.59.0"
	},
	"dependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
